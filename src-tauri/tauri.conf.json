{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/tauri-v2/core/tauri-config-schema/schema.json",
  "productName": "Revisor",
  "identifier": "com.revisor.app",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Revisor",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
