          "tag": { "color": "#7ee787" },
          "text.literal": { "color": "#a5d6ff" },
          "title": { "color": "#79c0ff", "font_weight": 600 },
          "type": { "color": "#ffa657" },
          "variable.special": { "color": "#ffa657" },
          "variant": { "color": "#79c0ff" }
        }
      }
